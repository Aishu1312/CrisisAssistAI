# CrisisAssist AI Environment Variables

# To use full LLM intelligence, obtain a Gemini API key from Google AI Studio
# and set it below. If left blank, the application will run in heuristic/fallback mock mode.
GEMINI_API_KEY=

# Custom location settings for geocoding fallback simulation (default: Mumbai, India)
DEFAULT_LOCATION=Mumbai

# Log configurations
OBSERVABILITY_LOG_LEVEL=DEBUG
